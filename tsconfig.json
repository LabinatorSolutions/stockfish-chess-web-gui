{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*.js", "server.js"],
	"exclude": ["node_modules", "dist"]
}
