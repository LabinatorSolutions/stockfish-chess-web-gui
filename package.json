{
	"name": "chess-console-stockfish",
	"version": "6.2.4",
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"bootstrap": "^5.3.8",
		"chess-console": "^6.14.1",
		"chess.mjs": "^2.4.1",
		"cm-chess": "^4.0.0",
		"cm-chessboard": "^8.15.1",
		"cm-engine-runner": "^2.1.0",
		"cm-web-modules": "^2.8.1"
	},
	"description": "StockfishPlayer for ChessConsole",
	"scripts": {
		"ci": "biome ci .",
		"dev": "bun build ./index.html --outdir ./dist --watch & bun run copy-assets & bun server.js",
		"start": "bun run dev",
		"build": "rm -rf dist && bun build ./index.html --outdir ./dist --minify && bun run copy-assets && bun run inject-static-tags",
		"inject-static-tags": "bun scripts/inject-static-tags.js",
		"copy-assets": "bun scripts/copy-assets.js",
		"preview": "bun server.js",
		"serve": "bun run preview",
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.19.0"
	}
}
